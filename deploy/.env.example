# Copy to deploy/.env on the server and fill in. Never commit the real file.

# Public hostname, proxied through Cloudflare (orange cloud) to port 8443.
TAP8583_DOMAIN=tap8583.example.com

# Password for the bundled Postgres (accounts, workspaces, transaction history).
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Outgoing email for sign-in links and invites. Any SMTP provider works
# (Resend, Postmark, Mailgun, Amazon SES...). Port 587 uses STARTTLS, 465 uses SSL.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# A sender address on a domain you have verified with the provider.
SMTP_FROM=Tap8583 <no-reply@example.com>

# Server-side masking of PAN, track data, expiry and PIN block. Keep true
# unless every terminal uses test cards only.
TAP8583_MASK_CARD_DATA=true

# Days of transaction history to keep.
TAP8583_RETENTION_DAYS=30

# Image tags to run (set by the deploy workflow; defaults to :latest).
# SERVER_IMAGE=ghcr.io/henryudorji/tap8583-server:latest
# WEB_IMAGE=ghcr.io/henryudorji/tap8583-web:latest
