# Served on 8443 behind Cloudflare's proxy: ports 80 and 443 on the server
# belong to another app's Caddy. Cloudflare reaches us through an Origin Rule
# (tap8583.<domain> -> port 8443) and verifies this Cloudflare Origin
# Certificate under SSL/TLS mode "Full (strict)". The certificate files live
# only on the server, in deploy/certs/ (see HETZNER_DEPLOYMENT.md).
{$TAP8583_DOMAIN}:8443 {
	tls /certs/origin.pem /certs/origin-key.pem

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	@backend path /api/* /ws/* /health
	handle @backend {
		request_body {
			max_size 1MB
		}
		reverse_proxy server:8080
	}

	handle {
		reverse_proxy web:3000
	}
}
